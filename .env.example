# store-multitenants-docker/.env.example

# ── Identité du container ──────────────────────────────────────────
SITE_NAME=store-multitenants
PORT_FRONTEND=3340

# ── Base de données PostgreSQL (woxxapp-core / network) ────────────
POSTGRES_USER=woxxapp
POSTGRES_PASSWORD=
POSTGRES_DB=store_multitenants

# ── Sécurité & Authentification ───────────────────────────────────
JWT_SECRET=              # openssl rand -hex 32

# ── WoxxPay (Paiement) ────────────────────────────────────────────
WOXX_PAY_API_URL=http://woxx-pay-api:8000
WOXX_PAY_M2M_CLIENT_ID=
WOXX_PAY_M2M_CLIENT_SECRET=
WOXX_PAY_PUBLIC_KEY=     # clé publique Ed25519 pour vérification des webhooks
